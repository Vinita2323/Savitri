PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shippnex?appName=Cluster0
JWT_SECRET=your_strong_random_jwt_secret_here

# Dev-only mock OTP (ignored when NODE_ENV=production unless explicitly set; set DISABLE_MOCK_OTP=true to turn off)
MOCK_OTP=123456

# Razorpay (payments + webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the webhook in Razorpay Dashboard -> Settings -> Webhooks (NOT the API key secret)
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS India Hub (OTP)
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_TEMPLATE_ID=
SMS_INDIA_HUB_ENTITY_ID=
SMS_INDIA_HUB_PEID=
SMS_INDIA_HUB_API_URL=
SMS_API_KEY=
SMS_PROVIDER_MODE=
DLT_PE_ID=
APP_NAME=Shippnex

# Firebase Admin (FCM) — prefer a service account JSON path, or set individual fields
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
FIREBASE_CONFIG=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

# Optional tuning
SYNC_INDEXES_ON_STARTUP=false
LOG_API_TIMINGS=false
